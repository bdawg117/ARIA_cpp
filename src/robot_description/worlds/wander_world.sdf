<?xml version="1.0"?>
<sdf version="1.9">
  <world name="wander_world">

    <!-- Physics -->
    <physics name="default" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Required plugins -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Sun -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="col">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
        </collision>
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Box obstacles ── -->

    <model name="box_1">
      <static>true</static>
      <pose>3 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1 1 1</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1 1 1</size></box></geometry>
          <material><ambient>0.6 0.2 0.2 1</ambient><diffuse>0.7 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_2">
      <static>true</static>
      <pose>-3 2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1 1 1</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1 1 1</size></box></geometry>
          <material><ambient>0.2 0.5 0.2 1</ambient><diffuse>0.2 0.6 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_3">
      <static>true</static>
      <pose>0 -4 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1 1 1</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1 1 1</size></box></geometry>
          <material><ambient>0.2 0.2 0.6 1</ambient><diffuse>0.2 0.2 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_4">
      <static>true</static>
      <pose>4 -3 0.75 0 0 0.4</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.5 2 1.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.5 2 1.5</size></box></geometry>
          <material><ambient>0.5 0.4 0.1 1</ambient><diffuse>0.6 0.5 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_5">
      <static>true</static>
      <pose>-4 -2 0.4 0 0 0.8</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2 0.4 0.8</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>2 0.4 0.8</size></box></geometry>
          <material><ambient>0.4 0.2 0.5 1</ambient><diffuse>0.5 0.2 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_6">
      <static>true</static>
      <pose>6 4 0.5 0 0 0.6</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.5 0.3 1</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1.5 0.3 1</size></box></geometry>
          <material><ambient>0.6 0.4 0.1 1</ambient><diffuse>0.7 0.5 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_7">
      <static>true</static>
      <pose>-6 5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1 1 1</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1 1 1</size></box></geometry>
          <material><ambient>0.1 0.5 0.5 1</ambient><diffuse>0.1 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_8">
      <static>true</static>
      <pose>2 6 0.4 0 0 1.1</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2.5 0.3 0.8</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>2.5 0.3 0.8</size></box></geometry>
          <material><ambient>0.5 0.1 0.4 1</ambient><diffuse>0.6 0.1 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_9">
      <static>true</static>
      <pose>-2 -7 0.5 0 0 0.3</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1 1 1</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1 1 1</size></box></geometry>
          <material><ambient>0.2 0.4 0.1 1</ambient><diffuse>0.3 0.5 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_10">
      <static>true</static>
      <pose>7 -1 0.6 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.4 0.4 1.2</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.4 0.4 1.2</size></box></geometry>
          <material><ambient>0.6 0.6 0.1 1</ambient><diffuse>0.7 0.7 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_11">
      <static>true</static>
      <pose>-7 -5 0.5 0 0 0.9</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.2 0.5 1</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1.2 0.5 1</size></box></geometry>
          <material><ambient>0.1 0.3 0.6 1</ambient><diffuse>0.1 0.4 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_12">
      <static>true</static>
      <pose>5 7 0.4 0 0 0.5</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>3 0.3 0.8</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>3 0.3 0.8</size></box></geometry>
          <material><ambient>0.5 0.3 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_13">
      <static>true</static>
      <pose>-5 3 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.5 0.5 1</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.5 0.5 1</size></box></geometry>
          <material><ambient>0.6 0.1 0.1 1</ambient><diffuse>0.7 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_14">
      <static>true</static>
      <pose>1 -6 0.5 0 0 0.7</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2 0.4 1</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>2 0.4 1</size></box></geometry>
          <material><ambient>0.3 0.5 0.4 1</ambient><diffuse>0.4 0.6 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_15">
      <static>true</static>
      <pose>-1 8 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1 1 1</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1 1 1</size></box></geometry>
          <material><ambient>0.4 0.1 0.5 1</ambient><diffuse>0.5 0.1 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Outer walls to keep the bot contained -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 10 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>20 0.2 1</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>20 0.2 1</size></box></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -10 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>20 0.2 1</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>20 0.2 1</size></box></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>10 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 20 1</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.2 20 1</size></box></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-10 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 20 1</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.2 20 1</size></box></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
